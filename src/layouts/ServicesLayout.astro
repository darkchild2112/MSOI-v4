---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/HOC/Container.astro';
import ServicesNavigation from '../components/ServicesNavigation/ServicesNavigation.astro';

const { title, description } = Astro.props;
---

<style lang="scss">
  @use '../styles/dimensions.scss' as *;

  .services-container {
    display: flex;
    gap: 2rem;
    padding-top: 30px;

    .nav-wrapper {
      @media screen and (max-width: $breakpoint-md) {
        & {
          display: none;
        }
      }
    }

    .services-content {
      width: 80%;

      @media screen and (max-width: $breakpoint-md) {
        & {
          width: 100%;
        }
      }
    }
  }
</style>

<BaseLayout title={title} description={description}>
  <Container>
    <div class="services-container">
      <section class="nav-wrapper">
        <ServicesNavigation pathname={Astro.url.pathname} />
      </section>
      <div class="services-content">
        <slot />
      </div>
    </div>
  </Container>
</BaseLayout>
