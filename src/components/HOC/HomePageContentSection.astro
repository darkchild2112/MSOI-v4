---
const { title, visuallyHiddenTitle } = Astro.props;
---

<style lang="scss">
  @import '../../styles/colors.scss';
  @import '../../styles/dimensions.scss';

  section {
    padding-top: 50px;

    @media screen and (max-width: $breakpoint-md) {
      padding-top: 20px;
    }

    h2 {
      padding-bottom: 25px;
      font-size: 30px;
      text-align: center;
      font-weight: 500;
      color: $primary-heading;
    }
  }
</style>

<section>
  {title && <h2 class={`${visuallyHiddenTitle === true ? 'visually-hidden' : null}`}>{title}</h2>}
  <slot />
</section>
