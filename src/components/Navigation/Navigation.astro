---
import { ServicesNavigationData } from '../ServicesNavigation/ServicesNavigationData.js';
---

<style lang="scss">
  @use '../../styles/dimensions.scss' as *;

  nav {
    display: flex;
    gap: 5px;

    @media (max-width: $breakpoint-md) {
      flex-direction: column;
      width: 70%;
      background-color: #fff;
      overflow-y: scroll;
      overflow-x: hidden;
    }

    a {
      color: #222121;
      padding: 15px 15px 15px 15px;
      line-height: 20px;
      background-color: transparent;
      transition:
        background-color 0.3s ease-in-out,
        color 0.3s ease-in-out;
      text-decoration: none;

      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }

      @media (max-width: $breakpoint-md) {
        padding: 10px;
      }

      &:hover:not(.active) {
        background-color: #27bbdf;
        color: #fff;
        opacity: 0.6;
      }

      &:visited {
        text-decoration: none;
      }

      &.active {
        background-color: #27bbdf;
        color: #fff;
      }

      &:focus-visible {
        outline: 2px solid transparent;
        background-color: #fd0;
        color: #000;
      }
    }

    .services-link {
      padding-left: 20px;

      @media (min-width: $breakpoint-md) {
        display: none;
      }
    }
  }
</style>

<nav id="navigation" aria-label="Main">
  <a href="/#body">Home</a>
  <a href="/#services">Services</a>
  {
    ServicesNavigationData.map(service => (
      <a href={service.link} class="services-link">
        {service.text}
      </a>
    ))
  }
  <a href="/#whatWeDo">About Us</a>
  <a href="/#whoWeAre">Who We Are</a>
  <a href="/#contact">Contact Us</a>
</nav>

<script>
  let scrollTimeout;

  document.querySelectorAll('#navigation a').forEach(link => {
    link.addEventListener('click', event => {
      const isInPageSectionLink =
        window.location.pathname === '/' && link.getAttribute('href')?.startsWith('/#');

      if (!isInPageSectionLink) return;

      const target = document.querySelector(resolveTargetHash(link.hash));

      if (!target) return;

      event.preventDefault();

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' });
    });
  });

  setTimeout(() => {
    setActiveLink();
    document.addEventListener('scroll', function () {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => setActiveLink(), 25);
    });
  }, 500);

  function resolveTargetHash(hash) {
    return hash === '#body' ? '#banner' : hash;
  }

  function setActiveLink() {
    const navigationLinks = document.querySelectorAll('#navigation a');

    navigationLinks?.forEach(node => {
      let isNodeActive = false;

      if (window.location.pathname === '/') {
        const hash = resolveTargetHash(node.hash);
        if (hash !== '') {
          const section = document.querySelector(hash);

          isNodeActive = isVisible(section);

          if (isNodeActive) {
            window.history.replaceState(null, null, hash);
          }
        }
      } else {
        isNodeActive = node.pathname === window.location.pathname;
      }

      setActiveNode(node, isNodeActive);
    });
  }

  function setActiveNode(node, isNodeActive) {
    if (isNodeActive) {
      node.classList.add('active');
    } else {
      node.classList.remove('active');
    }
  }

  function isVisible(element) {
    const rect = element.getBoundingClientRect();
    const viewHeight = Math.max(document.documentElement.clientHeight, window.innerHeight);
    const verticalCenter = viewHeight / 3;
    return rect.top <= verticalCenter && rect.bottom >= verticalCenter;
  }
</script>
