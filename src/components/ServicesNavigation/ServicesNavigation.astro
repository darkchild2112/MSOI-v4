---
// Should I just pull this from the services data file?
import { ServicesNavigationData } from './ServicesNavigationData.js';
---

<style lang="scss">
  nav {
    display: flex;
    flex-direction: column;
    padding: 0;

    a {
      color: #222121;
      padding: 10px;
      line-height: 20px;
      background-color: transparent;
      transition: background-color 0.2s ease-in-out;
      transition: color 0.1s ease-in-out;
      text-decoration: none;
      border: 1px solid transparent;

      &:hover:not(.active) {
        border-color: #27bbdf;
      }

      &:visited {
        text-decoration: none;
      }

      &.active {
        background-color: #27bbdf;
      }

      &:focus-visible {
        outline: 2px solid transparent;
        background-color: #fd0;
        color: #000;
      }
    }
  }
</style>

<nav aria-label="Services">
  {
    ServicesNavigationData.map(service => (
      <a href={service.link} class={service.link == Astro.props.pathname ? 'active' : null}>
        {service.text}
      </a>
    ))
  }
</nav>
