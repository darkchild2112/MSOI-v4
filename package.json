{
  "name": "msoi-v4",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,astro,scss,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,astro,scss,css,json,md}\"",
    "test:e2e": "playwright test",
    "astro": "astro",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@types/react": "^18.2.33",
    "@types/react-dom": "^18.2.14",
    "astro": "^7.2.1",
    "bootstrap-reboot": "^4.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.68.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": "eslint --fix --max-warnings=0",
    "*.{js,jsx,ts,tsx,astro,scss,css,json,md}": "prettier --write"
  }
}
